{
  "name": "hookgate-oss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OSS webhook proxy for safely relaying events to Discord and Slack through Cloudflare Workers.",
  "license": "MIT",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "check": "npm run check -w apps/api && npm run lint -w apps/web"
  },
  "keywords": [
    "webhook",
    "proxy",
    "cloudflare-workers",
    "discord",
    "slack",
    "supabase"
  ],
  "engines": {
    "node": ">=20"
  }
}
